# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
venv/
.venv/
*.egg

# Secrets, if any ever appear
.env

logs/
*.log
*.db
*.sqlite
*.sqlite3

# IDE / Editor
.aider*
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.cache
cache/
output.txt.txt

# Media (uploaded/generated)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tiff
*.pdf

# …except curated docs/ assets the docs link to.
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.webp

# Temp files
_scratch/
*.error.log

# Windows export tooling (downloaded, not vendored) — see godot/docs/Build.md
tools/rcedit-x64.exe

# Pre-baked world packages — SHIPPED AS RELEASE ASSETS, not in git.
# The Great Bake produces ~1.4 GB of these (six worlds, ~250 MB each); the exe
# bundles them at export time and the installer fetches the exe, so nothing in
# the build path needs them from a clone. Rebuild any of them locally with
# tests/bake_worlds.tscn + scripts/bake_zip.py — see docs/AssetBake.md.
godot/baked/*.zip

# NobodyWho GDExtension binaries (godot/docs/Architecture.md).
# 145 MB — over GitHub's 100 MB per-file hard limit, so it CANNOT be committed
# even if we wanted to. Same treatment as godot/baked/*.zip: a release asset,
# fetched by scripts/fetch_nobodywho.py. The manifest and icon stay tracked, so
# the addon's shape is in git even when its binary is not.
godot/addons/nobodywho/*.dll
godot/addons/nobodywho/*.so
godot/addons/nobodywho/*.dylib
godot/addons/nobodywho/*.pdb

# Inno Setup build output — a ~10 MB binary, rebuilt by iscc on demand
installer/Output/

# ...but the CC0 character textures are SOURCE, not generated output. 30 KB total,
# and the meshes render white without them — the blanket *.png above was aimed at
# the art cache, never at these.
!godot/spike3d/models/*.png
!godot/spike3d/materials/*.png
