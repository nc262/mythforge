research_data/
**/search_analytics.json

# Internal dev/review notes — not for public repo
dev-docs/
# Windows-port working docs (local only, not for public repo)
docs/windows-port/

# Local config
compound.config.json
*.error.log
_scratch/

# Local machine only — never ship these
*.pem
chroma/
_startup-backup/
New Text Document.txt
_boot-stack.cmd
_run-odysseus.bat
dist/

# Windows export tooling (downloaded, not vendored) — see docs/Build.md
tools/rcedit-x64.exe

# Pre-baked world packages — SHIPPED AS RELEASE ASSETS, not in git.
# The Great Bake produces ~1.4 GB of these (six worlds, ~250 MB each); the exe
# bundles them at export time and the installer fetches the exe, so nothing in
# the build path needs them from a clone. Rebuild any of them locally with
# tests/bake_worlds.tscn + scripts/bake_zip.py — see docs/AssetBake.md.
godot/baked/*.zip

# NobodyWho GDExtension binaries (docs/Architecture-InProcess.md).
# 145 MB — over GitHub's 100 MB per-file hard limit, so it CANNOT be committed
# even if we wanted to. Same treatment as godot/baked/*.zip: a release asset,
# fetched by scripts/fetch_nobodywho.py. The manifest and icon stay tracked, so
# the addon's shape is in git even when its binary is not.
godot/addons/nobodywho/*.dll
godot/addons/nobodywho/*.so
godot/addons/nobodywho/*.dylib
godot/addons/nobodywho/*.pdb
